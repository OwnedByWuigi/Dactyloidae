# -*- Mode: python; indent-tabs-mode: nil; tab-width: 40 -*-

EXPORTS.mozilla.dom += [
    'USB.h',
    'USBAlternateInterface.h',
    'USBBackend.h',
    'USBConfiguration.h',
    'USBDescriptors.h',
    'USBDevice.h',
    'USBEndpoint.h',
    'USBInterface.h',
    'USBInTransferResult.h',
    'USBOutTransferResult.h',
]

UNIFIED_SOURCES += [
    'USB.cpp',
    'USBBackend.cpp',
    'USBDescriptors.cpp',
    'USBDevice.cpp',
]

if CONFIG['OS_TARGET'] == 'WINNT':
    SOURCES += ['USBBackendWin.cpp']
    OS_LIBS += ['setupapi', 'winusb']
