+bool
+BaselineCacheIRCompiler::emitGuardCompartment()
+{
+    Register obj = allocator.useRegister(masm, reader.objOperandId());
+    reader.stubOffset(); // Read global wrapper.
+    AutoScratchRegister scratch(allocator, masm);
+
+    FailurePath* failure;
