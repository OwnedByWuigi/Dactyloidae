+        /* Start after the roots. */
+        VerifyNode* node = NextNode(trc->root);
+        while ((char*)node < trc->edgeptr) {
+            cetrc.node = node;
+            js::TraceChildren(&cetrc, node->thing, node->kind);
+
+            if (node->count <= MAX_VERIFIER_EDGES) {
+                for (uint32_t i = 0; i < node->count; i++) {
