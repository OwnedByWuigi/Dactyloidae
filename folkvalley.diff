+AutoOutputRegister::AutoOutputRegister(CacheIRCompiler& compiler)
+  : output_(compiler.outputUnchecked_.ref()),
+    alloc_(compiler.allocator)
+{
+    if (output_.hasValue())
+        alloc_.allocateFixedValueRegister(compiler.masm, output_.valueReg());
