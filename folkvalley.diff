+static const unsigned AsmJSMaxFuncs          = 512 * 1024;
+static const unsigned AsmJSMaxImports        =   4 * 1024;
+static const unsigned AsmJSMaxTables         =   4 * 1024;
+static const unsigned AsmJSFirstDefFuncIndex = AsmJSMaxImports + 1;
