-static void
-ReplaceHourSymbol(mozilla::Span<char16_t> pattern, HourCycle hc)
-{
-    char16_t replacement = HourSymbol(hc);
-    PatternIterator<char16_t> iter(pattern);
-    while (auto* ptr = iter.next()) {
-        char16_t ch = *ptr;
-        if (ch == 'K' || ch == 'h' || ch == 'H' || ch == 'k') {
-            *ptr = replacement;
-        }
-    }
-}
