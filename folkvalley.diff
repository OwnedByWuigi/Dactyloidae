-HourSymbol(HourCycle hc)
-{
-    switch (hc) {
-      case HourCycle::H11:
-        return 'K';
-      case HourCycle::H12:
-        return 'h';
-      case HourCycle::H23:
-        return 'H';
-      case HourCycle::H24:
-        return 'k';
