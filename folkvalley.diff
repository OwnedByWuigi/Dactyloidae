+
+    /*
+     * If the weakKeys table OOMs, disable the linear algorithm and fall back
+     * to iterating until the next GC.
+     */
+    ActiveThreadData<bool> linearWeakMarkingDisabled_;
+
+#ifdef DEBUG
+    /* Count of arenas that are currently in the stack. */
