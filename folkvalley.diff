-    if (nbytes <= sizeof(NativeObject))
-        return AllocKind::OBJECT0;
-    nbytes -= sizeof(NativeObject);
-
-    size_t dataSlots = AlignBytes(nbytes, sizeof(Value)) / sizeof(Value);
